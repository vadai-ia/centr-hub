# ============================================================
# Centr Hub — Variables de entorno
# Copiar a .env.local con valores reales (nunca commitear .env.local)
# ============================================================

# ---- Supabase ----
# URL del proyecto Supabase (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon key (pública — solo permisos de RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL base pública del sitio. Se usa para construir los links de
# invitación/recuperación que aterrizan en /auth/confirm. DEBE ser el dominio
# exacto con esquema, SIN slash final ni path (el código hace `${url}/auth/confirm`).
# Prod: https://centr-hub.vercel.app  ·  Local: http://localhost:3000 (default si falta)
# Debe coincidir EXACTO con el "Site URL" configurado en Supabase Auth.
NEXT_PUBLIC_SITE_URL=https://your-domain

# Service role key (SOLO server-side — NUNCA al navegador)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Inngest ----
INNGEST_EVENT_KEY=your-inngest-event-key
INNGEST_SIGNING_KEY=your-inngest-signing-key

# ---- Upstash Redis ----
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ---- Shopify (por tenant — se mueve a Supabase Vault en M3) ----
# Configurar en Supabase Vault tras M3; aquí solo para dev inicial
SHOPIFY_WEBHOOK_SECRET=your-shopify-webhook-secret

# ---- Whaapy (se mueve a Supabase Vault en M3/M4) ----
# api_key usado server-side para llamadas salientes (NO para el iframe)
WHAAPY_API_KEY=your-whaapy-api-key
